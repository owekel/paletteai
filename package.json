{
  "name": "palette-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PaletteAI — analyzes a photo's colouring and recommends a clothing colour palette. Client-side only.",
  "engines": { "node": "24.x" },
  "scripts": {
    "test": "node scripts/test-results.mjs",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "predev": "npm run assets:prepare",
    "dev": "vite",
    "prebuild": "npm run assets:prepare",
    "build": "tsc -b && vite build && node scripts/verify-dist.mjs",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "autoprefixer": "10.6.1",
    "esbuild": "0.28.2",
    "postcss": "8.5.31",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "7.3.7"
  },
  "overrides": { "postcss-selector-parser": "7.1.6", "source-map-js": "1.2.2" }
}
