{
  "compilerOptions": {
    "composite": true,
    "outDir": "./node_modules/.cache/paletteai-tsc",
    "tsBuildInfoFile": "./node_modules/.cache/paletteai-tsc/build.tsbuildinfo",
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true
  },
  "include": ["vite.config.ts", "vercel.json"]
}
